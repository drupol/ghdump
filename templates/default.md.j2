{% block checks -%}
{%- if checks -%}
{{ render_heading(2, "Checks (" ~ checks | length ~ ")") -}}
{%- set checks_ns = namespace(success=0, failed=0, pending=0, cancelled=0) -%}
{%- for check in checks -%}
  {%- set raw_status = (check.conclusion if check.conclusion else check.status) | lower -%}
  {%- if raw_status in ["success", "neutral", "skipped"] -%}
    {%- set checks_ns.success = checks_ns.success + 1 -%}
  {%- elif raw_status in ["failure", "timed_out", "action_required", "startup_failure"] -%}
    {%- set checks_ns.failed = checks_ns.failed + 1 -%}
  {%- elif raw_status in ["cancelled", "stale"] -%}
    {%- set checks_ns.cancelled = checks_ns.cancelled + 1 -%}
  {%- else -%}
    {%- set checks_ns.pending = checks_ns.pending + 1 -%}
  {%- endif -%}
{%- endfor -%}
{%- set ordered_statuses = [
  "failure", "timed_out", "action_required", "startup_failure",
  "pending", "queued", "in_progress", "requested", "waiting",
  "cancelled", "stale",
  "skipped", "success", "neutral"
] -%}
| Name | Source | Result | Description |{{ "\n" -}}
|---|---|---|---|{{ "\n" -}}
{%- for grouped_status in ordered_statuses -%}
  {%- for check in checks | sort(attribute="name") -%}
    {%- set raw_status = (check.conclusion if check.conclusion else check.status) | lower -%}
    {%- if raw_status in ["success", "neutral"] -%}
      {%- set normalized_status = "success" -%}
    {%- elif raw_status == "skipped" -%}
      {%- set normalized_status = "skipped" -%}
    {%- elif raw_status in ["failure", "timed_out", "action_required", "startup_failure"] -%}
      {%- set normalized_status = raw_status -%}
    {%- elif raw_status in ["cancelled", "stale"] -%}
      {%- set normalized_status = raw_status -%}
    {%- elif raw_status in ["pending", "queued", "in_progress", "requested", "waiting"] -%}
      {%- set normalized_status = raw_status -%}
    {%- else -%}
      {%- set normalized_status = "other" -%}
    {%- endif -%}
    {%- if normalized_status == grouped_status -%}
      {%- set status_label = (check.conclusion if check.conclusion else check.status) -%}
      {%- set name_label = ("[" ~ (check.name | replace("|", "\\|")) ~ "](" ~ check.url ~ ")") if check.url else (check.name | replace("|", "\\|")) -%}
      {%- set description_label = (check.description | replace("|", "\\|")) if check.description else "" -%}
| {{ name_label }} | `{{ check.kind }}` | `{{ status_label | replace("|", "\\|") }}` | {{ description_label }} |{{ "\n" -}}
    {%- endif -%}
  {%- endfor -%}
{%- endfor -%}
{%- for check in checks | sort(attribute="name") -%}
  {%- set raw_status = (check.conclusion if check.conclusion else check.status) | lower -%}
  {%- if raw_status not in ordered_statuses -%}
    {%- set status_label = (check.conclusion if check.conclusion else check.status) -%}
    {%- set name_label = ("[" ~ (check.name | replace("|", "\\|")) ~ "](" ~ check.url ~ ")") if check.url else (check.name | replace("|", "\\|")) -%}
    {%- set description_label = (check.description | replace("|", "\\|")) if check.description else "" -%}
| {{ name_label }} | `{{ check.kind }}` | `{{ status_label | replace("|", "\\|") }}` | {{ description_label }} |{{ "\n" -}}
  {%- endif -%}
{%- endfor -%}
{{ "\n" -}}
{{ render_field("Passing", checks_ns.success) -}}
{{ render_field("Failing", checks_ns.failed) -}}
{{ render_field("Pending", checks_ns.pending) -}}
{{ render_field("Cancelled", checks_ns.cancelled) -}}
{%- endif -%}
{%- endblock %}

{% block participants -%}
{%- set part_ns = namespace(logins=[], items=[]) -%}
{%- if author and author.login not in part_ns.logins -%}
  {%- set part_ns.logins = part_ns.logins + [author.login] -%}
  {%- set item -%}{{ render_actor(author) }} (author){%- endset -%}
  {%- set part_ns.items = part_ns.items + [item | trim] -%}
{%- endif -%}
{%- if merged_by and merged_by.login not in part_ns.logins -%}
  {%- set part_ns.logins = part_ns.logins + [merged_by.login] -%}
  {%- set item -%}{{ render_actor(merged_by) }} (merger){%- endset -%}
  {%- set part_ns.items = part_ns.items + [item | trim] -%}
{%- endif -%}
{%- for review in reviews -%}
  {%- if review.author and review.author.login not in part_ns.logins -%}
    {%- set part_ns.logins = part_ns.logins + [review.author.login] -%}
    {%- set item -%}{{ render_actor(review.author) }} (reviewer){%- endset -%}
    {%- set part_ns.items = part_ns.items + [item | trim] -%}
  {%- endif -%}
{%- endfor -%}
{%- for comment in comments recursive -%}
  {%- if comment.author and comment.author.login not in part_ns.logins -%}
    {%- set part_ns.logins = part_ns.logins + [comment.author.login] -%}
    {%- set item -%}{{ render_actor(comment.author) }} (commenter){%- endset -%}
    {%- set part_ns.items = part_ns.items + [item | trim] -%}
  {%- endif -%}
  {%- if comment.replies -%}{{- loop(comment.replies) -}}{%- endif -%}
{%- endfor -%}
{%- for thread in review_threads -%}
  {%- for comment in thread.comments -%}
    {%- if comment.author and comment.author.login not in part_ns.logins -%}
      {%- set part_ns.logins = part_ns.logins + [comment.author.login] -%}
      {%- set item -%}{{ render_actor(comment.author) }} (review commenter){%- endset -%}
      {%- set part_ns.items = part_ns.items + [item | trim] -%}
    {%- endif -%}
  {%- endfor -%}
{%- endfor -%}
{%- if part_ns.items -%}
{{ render_heading(2, "Participants (" ~ part_ns.items | length ~ ")") -}}
{{ render_field(none, part_ns.items) }}{{ "\n" -}}
{%- endif -%}
{%- endblock %}

{% block reviews_summary -%}
{%- if reviews -%}
{%- set rev_ns = namespace(approved=[], changes_requested=[], commented=[], dismissed=[]) -%}
{%- for review in reviews -%}
  {%- set entry -%}{{ render_actor(review.author) }}{%- endset -%}
  {%- if review.state | upper == "APPROVED" -%}
    {%- set rev_ns.approved = rev_ns.approved + [entry | trim] -%}
  {%- elif review.state | upper == "CHANGES_REQUESTED" -%}
    {%- set rev_ns.changes_requested = rev_ns.changes_requested + [entry | trim] -%}
  {%- elif review.state | upper == "COMMENTED" -%}
    {%- set rev_ns.commented = rev_ns.commented + [entry | trim] -%}
  {%- elif review.state | upper == "DISMISSED" -%}
    {%- set rev_ns.dismissed = rev_ns.dismissed + [entry | trim] -%}
  {%- endif -%}
{%- endfor -%}
{{ render_heading(2, "Reviews Summary") -}}
{{ render_field("Approved", rev_ns.approved) -}}
{{ render_field("Changes requested", rev_ns.changes_requested) -}}
{{ render_field("Commented", rev_ns.commented) -}}
{{ render_field("Dismissed", rev_ns.dismissed) -}}
{{ "\n" -}}
{%- endif -%}
{%- endblock %}

