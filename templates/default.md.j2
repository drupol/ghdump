{%- macro render_field(name, value, key=none, wrap="", depth=0) -%}
{%- set val = value[key] if key is not none else value -%}
{%- if val is defined and val is not none and (val is not string or val | trim) -%}
{%- if val is iterable and val is not string -%}
{%- if val | length > 0 -%}
{%- if name -%}{{ "  " * depth }}- {{ name }}:{{ "\n" }}{%- endif -%}
{%- for item in val -%}{{ render_field(none, item, wrap=wrap, depth=depth + (1 if name else 0)) }}{%- endfor -%}
{%- endif -%}
{%- else -%}
{{ "  " * depth }}- {{ (name ~ ": ") if name }}{{ wrap }}{{ val | replace("\n", "\n" ~ ("  " * depth)) }}{{ wrap }}{{ "\n" -}}
{%- endif -%}
{%- endif -%}
{%- endmacro -%}

{%- macro render_metadata(fields) -%}
{%- for field in fields -%}{{ render_field(field.name, field.value, key=field.key|default(none), wrap=field.wrap|default("")) }}{%- endfor -%}
{%- endmacro -%}

{%- macro render_actor(actor) -%}
{%- if actor -%}
{%- if actor.url -%}[{{ actor.login }}]({{ actor.url }}){%- else -%}{{ actor.login }}{%- endif -%}
{%- else -%}
unknown
{%- endif -%}
{%- endmacro -%}

{%- macro render_kind_label(kind) -%}
{{- kind_labels[kind] if kind in kind_labels else kind -}}
{%- endmacro -%}

{%- macro render_reaction_emoji(content) -%}
{{- reaction_emojis[content] if content in reaction_emojis else "" -}}
{%- endmacro -%}

{%- macro render_heading(level, text) -%}
{{ "#" * level }} {{ text }}{{ "\n\n" -}}
{%- endmacro -%}

{%- macro render_common_metadata(entry) -%}
{%- set fields = [] -%}
{%- if entry.url %}{% set fields = fields + [dict(name="URL", value=entry.url)] %}{% endif -%}
{%- if entry.created_at %}{% set fields = fields + [dict(name="Created", value=entry.created_at)] %}{% endif -%}
{%- if entry.updated_at %}{% set fields = fields + [dict(name="Updated", value=entry.updated_at)] %}{% endif -%}
{%- if entry.author_association %}{% set fields = fields + [dict(name="Author association", value="`" ~ entry.author_association ~ "`")] %}{% endif -%}
{%- if entry.is_answer %}{% set fields = fields + [dict(name="Marked answer", value="Yes")] %}{% endif -%}
{{- render_metadata(fields) -}}
{%- endmacro -%}

{%- macro render_reaction_item(reaction) -%}
{%- set emoji = render_reaction_emoji(reaction.content) -%}
{{ (emoji ~ " ") if emoji }}`{{ reaction.content }}`: {{ reaction.count }}x by
{%- for user in reaction.users %}
  - {{ render_actor(user) }}
{%- endfor -%}
{%- if reaction.count > reaction.users|length %}
  - (+{{ reaction.count - reaction.users|length }} more)
{%- endif -%}
{%- endmacro -%}

{%- macro render_reactions(reactions) -%}
{%- for reaction in reactions -%}- {{ render_reaction_item(reaction) | trim }}{{ "\n" }}{%- endfor -%}
{%- endmacro -%}

{%- macro render_label(label) -%}
`{{ label.name }}`{% if label.color %} (`#{{ label.color }}`){% endif %}{% if label.description %}: {{ label.description }}{% endif %}
{%- endmacro -%}

{%- macro render_fenced_block(content, language="") -%}
{%- if content is not none and (content | trim) -%}
```{% if language %}{{ language }}{% endif %}
{{ content }}
```
{{ "\n" }}{% endif -%}
{%- endmacro -%}

{%- macro render_markdown_block(body) -%}
{{- render_fenced_block(body, "md") -}}
{%- endmacro -%}

{%- macro render_collapsible_section(summary, content) -%}
{%- if content is not none and (content | trim) -%}
<details>
<summary>{{ summary }}</summary>

{{ content }}
</details>
{{ "\n" -}}
{%- endif -%}
{%- endmacro -%}

{%- macro render_diff_block(diff_text, summary="View Diff") -%}
{{- render_collapsible_section(summary, render_fenced_block(diff_text, "diff")) -}}
{%- endmacro -%}

