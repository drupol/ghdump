  {%- set diff_ns.deletions = diff_ns.deletions + file.deletions -%}
{%- endfor -%}
{# --- Unique participants (author + commenters + reviewers + review commenters) --- #}
{%- set participants_ns = namespace(logins=[]) -%}
{%- if author and author.login not in participants_ns.logins -%}
  {%- set participants_ns.logins = participants_ns.logins + [author.login] -%}
{%- endif -%}
{%- for comment in comments recursive -%}
  {%- if comment.author and comment.author.login not in participants_ns.logins -%}
    {%- set participants_ns.logins = participants_ns.logins + [comment.author.login] -%}
  {%- endif -%}
  {%- if comment.replies -%}{{- loop(comment.replies) -}}{%- endif -%}
{%- endfor -%}
{%- for review in reviews -%}
  {%- if review.author and review.author.login not in participants_ns.logins -%}
    {%- set participants_ns.logins = participants_ns.logins + [review.author.login] -%}
  {%- endif -%}
{%- endfor -%}
{%- for thread in review_threads -%}
  {%- for comment in thread.comments -%}
    {%- if comment.author and comment.author.login not in participants_ns.logins -%}
      {%- set participants_ns.logins = participants_ns.logins + [comment.author.login] -%}
    {%- endif -%}
  {%- endfor -%}
{%- endfor -%}
