  {%- set reaction_total.count = reaction_total.count + reaction.count -%}
{%- endfor -%}
{%- for comment in comments recursive -%}
  {%- for reaction in comment.reactions -%}
    {%- set reaction_total.count = reaction_total.count + reaction.count -%}
  {%- endfor -%}
  {%- if comment.replies -%}
    {{- loop(comment.replies) -}}
  {%- endif -%}
{%- endfor -%}
{%- for review in reviews -%}
  {%- for reaction in review.reactions -%}
    {%- set reaction_total.count = reaction_total.count + reaction.count -%}
  {%- endfor -%}
{%- endfor -%}
{%- for thread in review_threads -%}
  {%- for comment in thread.comments -%}
    {%- for reaction in comment.reactions -%}
      {%- set reaction_total.count = reaction_total.count + reaction.count -%}
    {%- endfor -%}
  {%- endfor -%}
{%- endfor -%}
{# --- Unresolved review threads --- #}
{%- set unresolved_ns = namespace(count=0) -%}
{%- for thread in review_threads -%}
  {%- if thread.is_resolved == false -%}
    {%- set unresolved_ns.count = unresolved_ns.count + 1 -%}
  {%- endif -%}
{%- endfor -%}
